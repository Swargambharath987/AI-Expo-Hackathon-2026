# Duty Line — LLM Configuration
# Copy this file to .env and fill in your values.

# --- Option A: Claude API (default, recommended) ---
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=sk-ant-your-key-here

# --- Option B: Ollama (offline / air-gapped) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma4:e4b
# LLM_API_KEY=ollama

# --- Option C: OpenRouter (flexible cloud routing) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_API_KEY=sk-or-your-key-here

# GSA API key (optional — per diem rates are pre-cached)
GSA_API_KEY=
